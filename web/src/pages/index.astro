---
// web/src/pages/index.astro: landing. Centered hero, live facts once they exist, three steps.
import Base from '../layouts/Base.astro';
import Stats from '../islands/Stats';
import Grainient from '../islands/Grainient';
const jsonLd = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Sideload', applicationCategory: 'MultimediaApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: 'Move your Spotify playlists, liked songs, saved albums and followed artists to YouTube Music. Free and open source.', url: 'https://sideload.marctorrelles.com', author: { '@type': 'Person', name: 'Marc Torrelles', url: 'https://marctorrelles.com' }, license: 'https://opensource.org/license/mit' };
---
<Base title="Sideload · Move your Spotify library to YouTube Music, free" description="Copy playlists, liked songs, saved albums and followed artists from Spotify to YouTube Music. Free, open source, no account. Anything that can't be matched is listed for you." jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__bg" transition:animate="fade"><Grainient centerY={0.12} saturation={0.9} client:visible /></div>
    <div class="container hero__in">
      <p class="eyebrow hero__eyebrow">Free · open source · nothing kept</p>
      <h1 class="h1 hero__h1">Ten years of playlists.<br />One afternoon saved.</h1>
      <p class="lede hero__lede">Sideload moves your Spotify library (playlists, liked songs, albums, followed artists) to YouTube Music. Anything it can't match gets handed back to you as a list, not lost.</p>
      <a class="btn hero__cta" href="/connect">Start a transfer</a>
    </div>
  </section>
  <section class="how" aria-label="How it works">
    <div class="container"><Stats client:idle /><div class="how__grid">
      <div><p class="eyebrow"><span class="c-accent">01</span> · Connect</p><p>Spotify read-only, then your new service.</p></div>
      <div><p class="eyebrow"><span class="c-accent">02</span> · Choose</p><p>Tick what's worth keeping. Leave the algorithm's stuff behind.</p></div>
      <div><p class="eyebrow"><span class="c-accent">03</span> · Walk away</p><p>Close the tab. Come back to a finished library.</p></div>
    </div></div>
  </section>
</Base>
<style>
  .hero { position: relative; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hero__bg::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 45%; background: linear-gradient(to bottom, transparent, var(--bg)); }
  .hero__bg :global(.grainient) { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s ease; }
  .hero__bg :global(.grainient.is-on) { opacity: 1; }
  .hero__in { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 92px; padding-bottom: 80px; }
  .hero__eyebrow { color: var(--accent); margin: 0 0 28px; }
  .hero__h1 { font-size: clamp(32px, 9.2vw, 64px); width: 100%; text-wrap: initial; }
  .hero__lede { max-width: 50ch; margin: 26px 0 0; font-size: 20px; }
  .hero__cta { margin-top: 40px; padding: 19px 36px; font-size: 17px; }
  .how :global(.stats) { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--hairline-strong); border-bottom: 0; }
  .how :global(.stats > div) { display: flex; flex-direction: column; gap: 16px; padding: 32px 22px 30px; border-left: 1px solid var(--hairline); }
  .how :global(.stats > div:first-child) { border-left: 0; }
  .how :global(.stats .stat) { font-size: 34px; }
  .how :global(.stats .eyebrow) { color: var(--fg-3); }
  .how__grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--hairline-strong); margin-bottom: 48px; }
  .how__grid > div { padding: 26px 22px 30px; border-left: 1px solid var(--hairline); }
  .how__grid > div:first-child { border-left: 0; }
  .how__grid .eyebrow { margin: 0 0 12px; color: var(--fg-3); }
  .how__grid p:not(.eyebrow) { margin: 0; font: 400 16px/1.5 var(--font-ui); color: var(--fg-2); max-width: 36ch; }
  @media (max-width: 900px) {
    .hero__in { padding-top: 54px; padding-bottom: 46px; }
    .hero__lede { font-size: 18px; }
    .hero__cta { display: flex; width: 100%; padding-top: 17px; padding-bottom: 17px; margin-top: 30px; }
    .how :global(.stats) { grid-template-columns: 1fr 1fr; }
    .how :global(.stats > div) { padding: 22px 16px; gap: 12px; }
    .how :global(.stats > div:nth-child(3)) { border-left: 0; }
    .how :global(.stats > div:nth-child(n+3)) { border-top: 1px solid var(--hairline); }
    .how :global(.stats .stat) { font-size: 28px; } .how :global(.stats .eyebrow) { font-size: 11px; }
    .how__grid { grid-template-columns: 1fr; margin-bottom: 32px; }
    .how__grid > div { border-left: 0; border-top: 1px solid var(--hairline); padding: 18px 16px 20px; }
    .how__grid > div:first-child { border-top: 0; }
  }
</style>
