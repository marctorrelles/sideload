---
// web/src/components/Placeholder.astro — hatched square until real provider marks / artwork land (see docs/design/handoff.md "Assets").
interface Props { size: 26 | 28 | 36 | 46 | 118; label?: string }
const { size, label } = Astro.props;
---
<span class={`placeholder ph-${size}`} aria-hidden="true">{label && <span class="ph__label">{label}</span>}</span>
<style>
  .placeholder { display: inline-grid; place-content: center; }
  .ph__label { font: 500 10px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--fg-4); }
</style>
