---
// web/src/components/Header.astro: identical on every screen, carries no progress state.
const coffee = 'https://buymeacoffee.com/marctorrelles';
---
<header class="hdr hairline-bottom"><div class="container hdr__in">
  <a href="/" class="wordmark" transition:name="wordmark">Sideload</a>
  <nav class="hdr__nav" aria-label="Site">
    <a href="/faq">FAQ</a>
    <a class="gh" href="https://github.com/marctorrelles/sideload" rel="noopener">GitHub</a>
    <a class="is-strong" href={coffee} rel="noopener noreferrer"><span class="desktop-only">Buy me a coffee</span><span class="mobile-only">Coffee</span></a>
  </nav>
</div></header>
<style>
  .hdr__in { display: flex; align-items: center; justify-content: space-between; padding-top: 16px; padding-bottom: 16px; }
  .wordmark { font: 700 20px/1 var(--font-ui); letter-spacing: -.02em; text-decoration: none; }
  .hdr__nav { display: flex; gap: 24px; }
  .hdr__nav a { font: 500 14px/1 var(--font-ui); color: var(--fg-2); text-decoration: none; transition: color var(--t-fast) ease; }
  .hdr__nav a:hover, .hdr__nav .is-strong { color: var(--fg); }
  .mobile-only { display: none; }
  @media (max-width: 900px) {
    .hdr__in { padding-top: 14px; padding-bottom: 14px; } .hdr__nav { gap: 16px; } .hdr__nav a { font-size: 14px; }
    .desktop-only { display: none; } .mobile-only { display: inline; } .hdr__nav .gh { display: none; }
  }
</style>
