{
  "name": "sideload",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm:dev:*\"",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && wrangler deploy",
    "spike:innertube": "tsx worker/scripts/spike-innertube.ts",
    "spike:spotify": "tsx worker/scripts/spike-spotify.ts",
    "calibrate": "tsx worker/scripts/calibrate-match.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.128.0",
    "tsx": "^4.19.0"
  },
  "packageManager": "pnpm@11.5.1"
}
