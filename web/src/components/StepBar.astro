---
// web/src/components/StepBar.astro — 01 Connect · 02 Choose · 03 Transfer
interface Props { step: 1 | 2 | 3 | 'done' }
const { step } = Astro.props;
const steps = [[1, 'Connect'], [2, 'Choose'], [3, 'Transfer']] as const;
const state = (n: number) => (step === 'done' ? 'done' : n < step ? 'done' : n === step ? 'current' : 'upcoming');
---
<div class="stepbar hairline-bottom" transition:name="stepbar"><ol class="container stepbar__in">
  {steps.map(([n, label]) => (
    <li class:list={['step', `is-${state(n)}`, { 'is-final': step === 'done' && n === 3 }]} aria-current={state(n) === 'current' ? 'step' : undefined}>
      <span class="num">0{n}</span> <span class="label">{label}</span>{state(n) === 'done' && <span class="tick"> ✓</span>}
    </li>
  ))}
</ol></div>
<style>
  .stepbar { background: var(--bg-sunken); }
  .stepbar__in { display: flex; gap: 26px; list-style: none; margin: 0; padding-top: 12px; padding-bottom: 12px; }
  .step { font: 500 10.5px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--fg-5); transition: color var(--t-med) ease; }
  .step.is-current { color: var(--accent); } .step.is-done { color: rgba(255,255,255,.38); } .step.is-final { color: var(--success); }
  @media (max-width: 900px) { .stepbar__in { gap: 16px; padding-top: 11px; padding-bottom: 11px; } .step.is-done .label { display: none; } }
</style>
