---
import Base from '../layouts/Base.astro';
---

<Base title="Not found · Sideload" description="Nothing here." noindex>
  <section class="container page">
    <p class="eyebrow mono page__eyebrow">404</p>
    <h1 class="h2">Nothing here.</h1>
    <p class="lede">Transfers live at <code>/t/…</code> links. If yours 404s, it was deleted after 7 days.</p>
    <a class="btn page__cta" href="/">Back to the start</a>
  </section>
</Base>
<style>
  .page {
    padding-top: 52px;
    padding-bottom: 60px;
  }
  .page__eyebrow {
    color: var(--accent);
    margin: 0 0 22px;
  }
  .page__cta {
    margin-top: 32px;
  }
</style>
