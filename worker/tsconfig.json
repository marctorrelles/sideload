{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "lib": ["ES2022"], "noEmit": true, "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "test", "../shared"]
}
