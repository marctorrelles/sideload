---
// web/src/pages/t/index.astro: served by the worker at /t/:id (X-Robots-Tag: noindex). The island renders its own step bar.
import Base from '../../layouts/Base.astro';
import Transfer from '../../islands/Transfer';
---
<Base title="Transfer · Sideload" description="Your Spotify → YouTube Music transfer." noindex>
  <Transfer client:only="preact" />
</Base>
<style is:global>
  .body { padding-top: 44px; padding-bottom: 34px; }
  .banner { background: var(--accent-banner); border-bottom: 1px solid var(--accent-banner-border); }
  .banner__in { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 13px; padding-bottom: 13px; font: 400 14px/1.5 var(--font-ui); }
  .banner b { font-weight: 500; }
  .banner__copy { white-space: nowrap; font-size: 13px; }
  .progress-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .progress-sub { margin-top: 12px; max-width: 58ch; }
  .pct--danger { color: var(--danger); }
  .seg { margin-top: 28px; }
  .legend { display: flex; gap: 22px; margin-top: 10px; }
  .legend b { color: var(--fg); font-weight: 500; }
  .sw { display: inline-block; width: 8px; height: 8px; margin-right: 6px; vertical-align: 0; }
  .sw--moved { background: var(--accent); } .sw--review { background: var(--accent-soft); } .sw--rest { background: rgba(255,255,255,.12); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 34px; align-items: start; }
  .col__label { color: var(--fg-3); margin-bottom: 10px; }
  .review-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .list > .review { padding: 14px 16px; }
  .list.warn > .review:first-child { background: var(--accent-tint-bg); }
  .review__head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .review__title { font: 500 16px/1.3 var(--font-ui); }
  .review__where { white-space: nowrap; font-size: 13px; }
  .review__reason { margin: 4px 0 0; font: 400 14px/1.5 var(--font-ui); color: var(--fg-3); }
  .review__reason.is-ok { color: var(--success); }
  .review__actions { display: flex; gap: 8px; align-items: center; margin-top: 10px; flex-wrap: wrap; }
  .review__search { margin-top: 10px; }
  .review__searchrow { display: flex; gap: 8px; } .review__searchrow .input { flex: 1; }
  .review__results { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .review__results li { display: flex; justify-content: space-between; gap: 10px; align-items: center; font: 400 14px/1.4 var(--font-ui); color: var(--fg-2); }
  .review__result { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .review__none { margin-top: 10px; }
  .actions--split { margin-top: 18px; }
  .actions--split .btn { padding: 13px 20px; font-size: 16px; }
  .row__toggle { width: 100%; border: 1px solid var(--warn-list-border); background: var(--accent-tint-bg); cursor: pointer; text-align: left; font: 500 15px/1.3 var(--font-ui); }
  .row__toggle + .list { border-top: 0; }
  .activity .row__title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row__text { min-width: 0; }
  /* done */
  .done { display: grid; grid-template-columns: 1.15fr .85fr; gap: 44px; padding-top: 56px; padding-bottom: 40px; align-items: start; }
  .done__lede { max-width: 52ch; }
  .statstrip { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--hairline-strong); margin-top: 28px; }
  .statstrip > div { padding: 20px 22px; border-left: 1px solid var(--hairline); display: flex; flex-direction: column; gap: 8px; }
  .statstrip > div:first-child { border-left: 0; }
  .statstrip .eyebrow { color: var(--fg-3); }
  .done__actions { margin-top: 26px; }
  .done__actions .btn { padding: 16px 26px; } .done__actions .btn--secondary { padding: 15px 22px; }
  .coffee { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 24px; margin-top: 28px; }
  .coffee__title { font: 600 17px/1.3 var(--font-ui); display: block; } .coffee__note { max-width: 46ch; margin-top: 6px; }
  .reassure { border: 1px solid var(--hairline-strong); padding: 16px; margin-top: 16px; font: 400 14px/1.6 var(--font-ui); color: var(--fg-3); }
  @media (max-width: 900px) {
    .body { padding-top: 30px; padding-bottom: 24px; }
    .banner__in { flex-direction: column; align-items: flex-start; gap: 6px; font-size: 14px; }
    .progress-head { gap: 14px; } .progress-sub { font-size: 15px; margin-top: 8px; }
    .seg { margin-top: 20px; } .legend { gap: 14px; flex-wrap: wrap; }
    .cols { grid-template-columns: 1fr; gap: 22px; margin-top: 26px; }
    .actions--split { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; } .actions--split .btn { width: 100%; padding: 16px 12px; }
    .done { grid-template-columns: 1fr; gap: 28px; padding-top: 36px; padding-bottom: 30px; }
    .statstrip { grid-template-columns: repeat(3, 1fr); } .statstrip > .statstrip__albums { display: none; } .statstrip > div { padding: 16px 14px; }
    .done__actions { flex-direction: column; align-items: stretch; } .done__actions .btn { width: 100%; padding-top: 17px; padding-bottom: 17px; } .done__actions .link { text-align: center; padding: 8px; }
    .coffee { flex-direction: column; align-items: stretch; } .coffee .btn { width: 100%; padding-top: 17px; padding-bottom: 17px; }
  }
</style>
