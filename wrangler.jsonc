// wrangler.jsonc: single Worker: API + Durable Objects + static site.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sideload",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"], // @sentry/cloudflare needs AsyncLocalStorage
  "workers_dev": false,
  "routes": [{ "pattern": "sideload.marctorrelles.com", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "JOB", "class_name": "JobDO" }, { "name": "STATS", "class_name": "StatsDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobDO", "StatsDO"] }],
  // Create with: pnpm wrangler kv namespace create MATCH_CACHE, then paste the id here.
  "kv_namespaces": [{ "binding": "MATCH_CACHE", "id": "b9bd25868271403b9d8802eb2091b332" }],
  "ratelimits": [
    { "name": "RL_AUTH",       "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_JOB_CREATE", "namespace_id": "1002", "simple": { "limit": 3,  "period": 60 } },
    { "name": "RL_READ",       "namespace_id": "1003", "simple": { "limit": 60, "period": 10 } },
    { "name": "RL_SEARCH",     "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "PUBLIC_ORIGIN": "https://sideload.marctorrelles.com" }
}
